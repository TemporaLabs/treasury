{
  "name": "@temporalabs/treasury",
  "version": "0.1.5",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TemporaLabs/treasury.git"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.connect-page.md",
    "llms.txt",
    "dist",
    "registry"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Agent Treasury by Tempora Labs — a depositor client for ERC-4626 vaults, reached through the Tempora API, and a Kamino vault on Solana: every step is checked before the operator's own wallet signs it. Never signs, never holds a key.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "treasury": "./dist/treasury.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm run build && git diff --exit-code -- dist/treasury.mjs THIRD_PARTY_NOTICES.md llms.txt",
    "build": "tsc -b && tsup && tsx scripts/third-party-notices.ts --write && tsx scripts/llms-txt.ts --write && bash scripts/sync-plugin.sh",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "test": "tsc -b && tsc -p tsconfig.scripts.json && vitest run",
    "test:fork": "tsc -b && TREASURY_FORK=1 vitest run --testTimeout 300000 tests/fork-solana.test.ts",
    "cli": "tsx src/cli.ts",
    "registry:check": "tsx scripts/registry-check.ts",
    "notices:check": "tsx scripts/third-party-notices.ts",
    "llms:check": "tsx scripts/llms-txt.ts",
    "plugin:check": "bash scripts/sync-plugin.sh --check && bash scripts/check-versions.sh",
    "lint:skill": "bash scripts/lint-skill.sh"
  },
  "dependencies": {
    "@temporalabs/client": "0.1.2",
    "@solana/kit": "^8.6.0",
    "viem": "2.57.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "esbuild@^0.27.0": "0.27.2"
  }
}
